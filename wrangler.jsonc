{
  "name": "cognita",
  "main": "worker.js",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],

  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },

  // Workers AI binding, used for Flux image generation and as a
  // last-resort text fallback provider.
  "ai": {
    "binding": "AI"
  },

  // KV namespace for server-side daily usage counters.
  "kv_namespaces": [
    {
      "binding": "COGNITA_USAGE",
      "id": "05f7fb2e0a7c47a68986c119fb5e5346"
    },
    {
      // Precomputed snapshots of published library content, so reads
      // don't have to hit Firestore on every request. Create this
      // namespace once with:
      //   wrangler kv namespace create COGNITA_LIBRARY_CACHE
      // then replace REPLACE_WITH_YOUR_NAMESPACE_ID below with the id
      // it prints.
      "binding": "COGNITA_LIBRARY_CACHE",
      "id": "REPLACE_WITH_YOUR_NAMESPACE_ID"
    }
  ],

  "vars": {
    "FIREBASE_PROJECT_ID": "cognita-b94eb",
    "APP_ORIGIN": "https://cognitai.vercel.app"
  }
}

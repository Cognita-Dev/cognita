{
  "name": "cognita",
  "main": "worker.js",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],

  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },

  // Workers AI binding, used for Flux image generation and as a
  // last-resort text fallback provider.
  "ai": {
    "binding": "AI"
  },

  // KV namespace for server-side daily usage counters.
  "kv_namespaces": [
    {
      "binding": "COGNITA_USAGE",
      "id": "05f7fb2e0a7c47a68986c119fb5e5346"
    },
    {
      "binding": "COGNITA_LIBRARY_CACHE",
      "id": "4b681c464cb84e8ca2c6ec148dad2067"
    },
    {
      "binding": "COGNITA_OAUTH_STATE",
      "id": "110124e1fcf8439a91509e56547c25c3"
    },
    // Reminders feature only: the "what's due right now" index plus
    // short-lived send claims. Kept separate from COGNITA_USAGE so
    // reminders never compete with existing usage-counter writes for the
    // free plan's daily KV write quota. REPLACE THE ID BELOW after you
    // create this namespace in the dashboard (step 2 of the upload order).
    {
      "binding": "COGNITA_REMINDERS",
      "id": "49b4f507e01e47ea85df4f5f1223cebd"
    },
    // Social Scheduler feature only: same "due index" idea as
    // COGNITA_REMINDERS above, kept in its own namespace for the same
    // reason. REPLACE THE ID BELOW with the id Cloudflare gives you when
    // you create this namespace — see the deployment steps.
    {
      "binding": "COGNITA_SOCIAL_SCHEDULE",
      "id": "8b67897786d742b1ae7ebc656cadfc82"
    }
  ],

  // Cloudflare's built-in rate limiters, used by the security layer at the
  // bottom of worker.js. "period" can only be 10 or 60 seconds. Counts are
  // kept per Cloudflare location. They use no KV storage. The namespace_id
  // numbers just need to be unique within your Cloudflare account.
  //   RL_GENERAL: any single visitor (by IP) may make at most 600 calls a
  //               minute. High on purpose: many students can share one
  //               school or mobile-network IP address.
  //   RL_HEAVY:   any single signed-in user may start at most 30 AI/image/
  //               upload jobs a minute.
  "ratelimits": [
    { "name": "RL_GENERAL", "namespace_id": "2001", "simple": { "limit": 600, "period": 60 } },
    { "name": "RL_HEAVY",   "namespace_id": "2002", "simple": { "limit": 30,  "period": 60 } }
  ],

  // Runs the reminders scheduler every 5 minutes, so reminders arrive within
  // ~5 min of their time. An idle run costs one KV list call and stops (288
  // runs/day). This is still ONE cron trigger, so the Workers Free plan's
  // 5-trigger limit is unaffected; check the plan's daily-request and KV
  // list/write quotas in the Cloudflare dashboard if traffic grows.
  // To go gentler, "*/10 * * * *" also works now that retries no longer
  // depend on the claim expiring (see reminders-scheduler.js).
  "triggers": {
    "crons": ["*/5 * * * *"]
  },

  "vars": {
    "FIREBASE_PROJECT_ID": "cognita-b94eb",
    "APP_ORIGIN": "https://app.cognita.com.ng",
    "WORKER_ORIGIN": "https://api.cognita.com.ng"
  }
}
